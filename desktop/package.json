{
  "name": "open-dots-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Open Dots desktop app, run from a source checkout: an Electron window around the local backend.",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app": "node scripts/run.js",
    "setup": "node scripts/setup.js",
