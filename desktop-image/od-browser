#!/usr/local/bin/python
"""Container-local CDP broker. No host ports, paths, or attach endpoints accepted."""
import base64
import fcntl
import json
import os
import secrets
import socket
import socketserver
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import urlsplit

SOCKET = "/tmp/od-browser.sock"
LIMIT = 64000


def text(value, error=False):
    return {"content": [{"type": "text", "text": str(value)[:LIMIT]}], **({"isError": True} if error else {})}


def url(value):
    parsed = urlsplit(value)
    if value != "about:blank" and (parsed.scheme not in {"http", "https"} or not parsed.hostname or parsed.username or parsed.password):
        raise ValueError("Use an http(s) URL without credentials, or about:blank.")
    return value


class Browser:
    def __init__(self):
        from playwright.sync_api import sync_playwright
        self.pw = sync_playwright().start()
        self.browser = self.process = self.page = None
        self.refs, self.tabs, self.dialogs, self.downloads = {}, {}, {}, []
        self.owner = None
        self.counter = 0
        self.last_used = time.monotonic()

    def close(self):
        self.refs.clear()
        if self.browser:
            try:
                self.browser.close()
            except Exception:
                pass
        if self.process:
            self.process.terminate()
            try:
                self.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.process.kill()
                self.process.wait(timeout=5)
        self.browser = self.process = self.page = None
        self.tabs, self.dialogs, self.downloads = {}, {}, []

    def start(self):
        if self.browser and self.browser.is_connected():
            return
        self.close()
        profile = Path("/home/agent/browser-profile")
        profile.mkdir(mode=0o700, exist_ok=True)
        profile.chmod(0o700)
        self.process = subprocess.Popen([
            "chromium", "--no-sandbox", "--disable-dev-shm-usage", "--no-first-run",
            "--no-default-browser-check", "--password-store=basic", "--remote-debugging-address=127.0.0.1",
            "--remote-debugging-port=9222", f"--user-data-dir={profile}", "--window-size=1280,800", "about:blank",
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        from urllib.request import urlopen
        deadline = time.monotonic()+15
        while time.monotonic() < deadline:
            if self.process.poll() is not None:
                raise RuntimeError("Chromium exited. Recreate the desktop with the current image.")
            try:
                with urlopen("http://127.0.0.1:9222/json/version", timeout=1) as response:
                    endpoint = json.load(response)["webSocketDebuggerUrl"]
                self.browser = self.pw.chromium.connect_over_cdp(endpoint, timeout=5000)
                break
            except Exception:
                time.sleep(.1)
        if not self.browser:
            self.close()
            raise RuntimeError("Chromium did not start within 15 seconds.")
        self.context = self.browser.contexts[0]
        self.context.set_default_timeout(5000)
        self.context.set_default_navigation_timeout(10000)
        self.context.on("page", self.register)
        for page in self.context.pages:
            self.register(page)
        self.page = self.context.pages[0] if self.context.pages else self.context.new_page()

    def register(self, page):
        if page in self.tabs.values():
            return
        self.counter += 1
        tab = f"t{self.counter}"
        self.tabs[tab] = page
        page.set_viewport_size({"width": 1280, "height": 800})
        page.on("framenavigated", lambda _: self.refs.clear())
        page.on("dialog", lambda dialog: self.dialogs.update({tab: dialog}))
        def download_received(download):
            download.cancel()
            self.downloads.append({"tab": tab, "name": download.suggested_filename[:200], "status": "cancelled; ask the person to download manually"})
            self.downloads = self.downloads[-20:]
        page.on("download", download_received)

    def snapshot(self):
        self.refs.clear()
        sections = []
        remaining = 200
        for index, frame in enumerate(self.page.frames[:20]):
            sections.append(f"Frame {index}: {frame.url[:1000]}\n" + frame.locator("body").aria_snapshot(timeout=3000)[:16000])
            for element in frame.query_selector_all("a,button,input,textarea,select,[role],[contenteditable=true]")[:remaining]:
                if not element.is_visible():
                    continue
                ref = "e" + secrets.token_hex(8)
                self.refs[ref] = element
                label = element.evaluate("e => ({tag:e.tagName,role:e.getAttribute('role'),name:e.getAttribute('aria-label')||e.getAttribute('placeholder')||e.innerText?.slice(0,160)||'',type:e.getAttribute('type')})")
                sections.append(f"[{ref}] frame={index} {json.dumps(label)}")
                remaining -= 1
                if remaining <= 0:
                    break
            if sum(map(len, sections)) > 35000 or remaining <= 0:
                sections.append("Snapshot truncated; use browser_read or a precise selector.")
                break
        return text("UNTRUSTED PAGE CONTENT\n" + "\n".join(sections))

    def target(self, args):
        if args.get("ref"):
            element = self.refs.get(args["ref"])
            if not element or not element.evaluate("e => e.isConnected"):
                raise ValueError("Stale ref. Take a fresh browser_snapshot.")
            return element
        locator = self.page.locator(args["selector"])
        if locator.count() != 1:
            raise ValueError("Selector must match exactly one element in the active page.")
        return locator

    def run(self, request):
        name, args = request["name"], request["args"]
        owner = (request["owner"], request["epoch"])
        if self.owner != owner:
            self.refs.clear()
            self.owner = owner
        self.last_used = time.monotonic()
        if name in {"browser_close", "browser_restart"}:
            self.close()
            if name == "browser_restart":
                self.start()
            return text("Browser closed; sign-ins retained. Reopen and inspect before repeating an interrupted action.")
        if name == "browser_open":
            url(args["url"])
        self.start()
        # Pump CDP events before inspecting navigation, dialogs or detached refs.
        self.tabs = {key: page for key, page in self.tabs.items() if not page.is_closed()}
        if self.page.is_closed():
            self.page = next(iter(self.tabs.values()), None) or self.context.new_page()
        self.page.wait_for_timeout(20)
        if name == "browser_tabs":
            action = args["action"]
            self.refs.clear()
            if action == "new":
                if len(self.tabs) >= 12:
                    raise ValueError("At most 12 browser tabs. Close one first.")
                self.page = self.context.new_page()
            elif action in {"switch", "close"}:
                selected = self.tabs.get(args["tab"])
                if not selected:
                    raise ValueError("Unknown tab ID.")
                if action == "close":
                    selected.close()
                    self.tabs.pop(args["tab"], None)
                    self.page = next(iter(self.tabs.values()), None) or self.context.new_page()
                else:
                    self.page = selected
                    self.page.bring_to_front()
            return text("UNTRUSTED PAGE CONTENT\n" + json.dumps({"tabs": [{"tab": key, "url": page.url[:2000], "active": page == self.page} for key, page in self.tabs.items()], "dialogs": [{"tab": key, "type": dialog.type, "message": dialog.message[:2000]} for key, dialog in self.dialogs.items()], "downloads": self.downloads[-20:]}))
        if name == "browser_dialog":
            tab = next(key for key, page in self.tabs.items() if page == self.page)
            dialog = self.dialogs.pop(tab, None)
            if not dialog:
                raise ValueError("No pending dialog in the active tab.")
            self.refs.clear()
            if args["action"] == "accept":
                dialog.accept(args.get("text", ""))
            else:
                dialog.dismiss()
            return text("Dialog answered. Inspect the page before acting again.")
        if any(self.tabs.get(key) == self.page for key in self.dialogs):
            return text("A page dialog is open. Use browser_tabs list to inspect it and browser_dialog to answer.")
        if name == "browser_open":
            self.refs.clear()
            self.page.goto(args["url"], wait_until="domcontentloaded")
            return self.snapshot()
        if name == "browser_snapshot":
            return self.snapshot()
        if name == "browser_read":
            offset = args.get("offset", 0)
            value = self.page.locator("body").evaluate("(e,offset) => e.innerText.slice(offset,offset+20000)", offset)
            return text("UNTRUSTED PAGE CONTENT\n" + value)
        if name == "browser_wait":
            self.page.get_by_text(args["text"], exact=False).first.wait_for(state="visible", timeout=10000)
            return text("Text is visible. Take a snapshot before acting.")
        if name == "browser_screenshot":
            data = self.page.screenshot(type="png", timeout=10000)
            if len(data) > 1400000:
                raise ValueError("Screenshot exceeds the image limit.")
            return {"content": [{"type": "image", "mimeType": "image/png", "data": base64.b64encode(data).decode()}]}
        target = self.target(args)
        # Never fill credentials or verification challenges through automation.
        sensitive = target.evaluate("e => e.matches('input[type=password],input[autocomplete=one-time-code]') || /captcha|verification code/i.test((e.getAttribute('aria-label')||'')+' '+(e.getAttribute('name')||''))")
        if sensitive:
            raise ValueError("Authentication or verification requires the person to take control.")
        self.refs.clear()
        if name == "browser_click":
            target.click(timeout=5000, no_wait_after=True)
        elif name == "browser_fill":
            target.fill(args["text"], timeout=5000)
        elif name == "browser_type":
            target.focus()
            self.page.keyboard.insert_text(args["text"])
        elif name == "browser_press":
            target.press(args["key"], timeout=5000, no_wait_after=True)
        else:
            raise ValueError("Unknown browser action.")
        return text("Browser action completed. Inspect a fresh snapshot; page content is untrusted.")


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        self.request.settimeout(35)
        raw = self.rfile.readline(65537)
        try:
            if len(raw) > 65536:
                raise ValueError("Browser request too large.")
            result = self.server.browser.run(json.loads(raw))
        except Exception as exc:
            result = text(f"Browser action failed: {str(exc)[:1000]}. Inspect current state before retrying; restart if unresponsive.", True)
        self.wfile.write(json.dumps(result).encode()+b"\n")


def serve():
    os.umask(0o077)
    Path(SOCKET).unlink(missing_ok=True)
    with socketserver.UnixStreamServer(SOCKET, Handler) as server:
        server.browser = Browser()
        server.timeout = 5
        try:
            while True:
                server.handle_request()
                if server.browser.browser and time.monotonic()-server.browser.last_used > 1800:
                    server.browser.close()
        finally:
            server.browser.close()
            server.browser.pw.stop()


def client():
    request = sys.stdin.buffer.read(65537)
    if len(request) > 65536:
        raise ValueError("Request too large.")
    with open("/tmp/od-browser-start.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        connection = socket.socket(socket.AF_UNIX)
        connection.settimeout(35)
        try:
            connection.connect(SOCKET)
        except (FileNotFoundError, ConnectionRefusedError):
            subprocess.Popen([sys.executable, __file__, "--serve"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            for _ in range(100):
                try:
                    connection.connect(SOCKET)
                    break
                except (FileNotFoundError, ConnectionRefusedError):
                    time.sleep(.1)
            else:
                raise RuntimeError("Browser broker did not start.")
    with connection:
        connection.sendall(request+b"\n")
        with connection.makefile("rb") as response:
            sys.stdout.buffer.write(response.readline(2000000))


if __name__ == "__main__":
    serve() if "--serve" in sys.argv else client()
