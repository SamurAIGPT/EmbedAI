# nginx on the host, in front of Open Dots on the same machine (docs/SELF-HOSTING.md, route 2).
#
# This is deploy/proxy/nginx.conf, the one that was tested (in a container, with a self-signed
# certificate that the client verified), with the address of the app changed to the loopback port.
# It has not been run on a real host with a real domain.
#
# nginx connects from loopback, which the server believes by default: set no TRUSTED_PROXIES.
# Get the certificate with certbot (or your provider) and renew it; nginx does not.
# Replace dots.example.com, and also set OPEN_DOTS_PUBLIC_URL=https://dots.example.com in the
# server's settings.
#
# What the server relies on, and this file provides:
#   - X-Forwarded-For is SET to the connecting address, never appended to ($remote_addr, not
#     $proxy_add_x_forwarded_for): a client cannot choose which address its failed sign-ins are
#     counted against.
#   - X-Forwarded-Proto says the visit was HTTPS, so the sign-in cookie is marked Secure.
#   - Host is passed through unchanged.
#   - The event stream is not buffered, and long reads and writes are allowed. Do not turn on gzip
#     for it.
#   - Uploads up to the server's own 10 MB image limit (plus form overhead) pass.
#   - /hooks/ goes to the app like everything else: webhooks carry their own per-routine secret.
#     To send them to a separate hooks-only process instead (docs/ROUTINES.md "Ingress"), add a
#     `location /hooks/` with proxy_pass http://127.0.0.1:8788 and the same three proxy_set_header lines.

server {
    listen 80;
    server_name dots.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name dots.example.com;

    ssl_certificate     /etc/letsencrypt/live/dots.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dots.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 20m;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location ~ ^/api/v1/threads/[0-9]+/events/stream$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_buffering off;
        proxy_cache off;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
    }
}
