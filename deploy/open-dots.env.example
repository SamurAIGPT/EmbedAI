# Settings for a direct install (docs/SELF-HOSTING.md, route 2). The guide writes the file for you
# in step 3; this lists the rest. It lives at /etc/open-dots/open-dots.env, owned by the service
# account, mode 0600. A value in the environment wins over a value in backend/.env.
# For Docker (route 1) the same names go in ./open-dots.env, beside compose.yaml.

# --- The address people use (required behind a proxy) ---
# Scheme and host only. Its host name is trusted as if listed in TRUSTED_HOSTS, and the
# pairing command prints links with it.
OPEN_DOTS_PUBLIC_URL=https://dots.example.com

# --- The secret key (required; back it up) ---
# Encrypts the credentials the server stores. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes stored credentials unreadable; changing it does too. A backup archive does
# not contain it. Keep a copy elsewhere.
TOKEN_ENCRYPTION_KEYS=

# --- Agents ---
# Agents run only when this is true. `python -m app.server doctor` reports it when it is not.
LOCAL_EXECUTION_ENABLED=true
# Tools (file edits and commands) are off until you turn them on; every command still asks for
# your approval in the app.
# LOCAL_TOOLS_ENABLED=true
# Where agents work. Default is ~/.open-dots/local.
# LOCAL_WORKSPACE_ROOT=/var/lib/open-dots/work

# --- Where the server listens (keep these behind a proxy on the same machine) ---
# Loopback only; the reverse proxy is the way in. Anything else needs OPEN_DOTS_ALLOW_PUBLIC_BIND=1.
OPEN_DOTS_HOST=127.0.0.1
OPEN_DOTS_PORT=8000
OPEN_DOTS_UI_DIR=/opt/open-dots/frontend/out

# --- The database ---
DATABASE_BACKEND=sqlite
# Default is ~/.open-dots/open-dots.db of the service account; set it to put the data elsewhere.
# SQLITE_PATH=/var/lib/open-dots/open-dots.db

# --- Proxies ---
# Loopback (127.0.0.1 and ::1) is always believed; a proxy on the same machine needs nothing here.
# For a proxy on another machine or in another container, name ITS address, never a whole network:
# TRUSTED_PROXIES=203.0.113.10
# See "Who is believed to be the proxy" in the guide.

# --- Engines ---
# Extra folders (colon-separated) to look in for an engine program, after the usual ones.
# OPEN_DOTS_EXTRA_PATH=/opt/engines/bin

# --- Leave off unless you understand the tradeoff (docs/AUTH.md) ---
LOOPBACK_TRUST=off
