BOAT_BASE_URL=https://boat.dev/api/v1
# Boat is optional: leave BOAT_API_KEY empty to run without it. If you set it,
# HOOK_TOKEN and PERMISSION_HOOK_BASE_URL below are required too.
BOAT_API_KEY=
# Required if your API key belongs to a personal account that also has an
# org/team on a paid plan -- sandbox creation bills to the personal account
# (and 402s) unless the org is attached here. Find the id via `box org list`
# or the Boat dashboard.
BOAT_ORG_ID=

# Optional free web search and page fetching for Claude tasks. No Parallel key.
PARALLEL_SEARCH_ENABLED=false

# Database. PostgreSQL (the POSTGRES_* values below, started by Docker) is the
# default. To use SQLite instead -- no Docker, one local file -- uncomment
# DATABASE_BACKEND (and optionally SQLITE_PATH; default ~/.open-dots/open-dots.db).
# SQLite is experimental: see docs/SETUP.md before using it with Boat sandboxes.
# DATABASE_BACKEND=sqlite
# SQLITE_PATH=
POSTGRES_USER=vadoo
POSTGRES_PASSWORD=vadoo
POSTGRES_DB=vadoo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# From @BotFather on Telegram. Optional if you only need the REST API.
TELEGRAM_BOT_TOKEN=
# Your bot's @username (without the @), shown to web UI users as a clickable
# link. Purely cosmetic.
TELEGRAM_BOT_USERNAME=

# Origin(s) allowed to call this API from a browser, comma-separated.
FRONTEND_ORIGINS=http://localhost:3000

# Owner authentication (docs/AUTH.md). Host names this server answers to; add
# your public name when self-hosting. Set the owner passphrase on first start
# from this machine, or with: uv run python -m app.auth.cli set-passphrase
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# off (default) | programs (scripts on this machine skip sign-in) | all (development)
LOOPBACK_TRUST=off

# A secret token that the webhook will require to be present in the request header. This is to prevent unauthorized requests from the public internet.generate one using 'python -c "import secrets; print(secrets.token_urlsafe(32))"'
HOOK_TOKEN=your-secret-token-here
PERMISSION_HOOK_BASE_URL=your-public-url-here

# Optional: run Claude through your own locally installed, signed-in `claude`
# CLI instead of a Boat sandbox. Chat-only (no tools) for now. Off by default;
# only usable from this machine (loopback). See docs/SETUP.md.
LOCAL_EXECUTION_ENABLED=false
# LOCAL_CLAUDE_CLI_PATH=
# LOCAL_WORKSPACE_ROOT=
# Let local Claude use tools (files, commands). Each tool call waits for your
# Allow/Deny in the web page. Off = chat-only. See docs/SETUP.md.
LOCAL_TOOLS_ENABLED=false
